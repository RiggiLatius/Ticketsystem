# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=bitte-ein-langes-zufaelliges-secret-eintragen

# Firmen-/Absenderkonfiguration
FIRMA_NAME=Reisser AG
MAIL_FROM=reklamation@firma.de
MAIL_NOTIFY_INBOX=reklamation@firma.de

# SMTP (ausgehende Mails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reklamation@firma.de
SMTP_PASS=

# IMAP (eingehende Antworten)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=reklamation@firma.de
IMAP_PASS=
IMAP_POLL_INTERVAL_MIN=5

# Uploads
UPLOAD_MAX_MB=5
